{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "framework": "vite",
  "rewrites": [
    { "source": "/geo", "destination": "/geo-dashboard.html" },
    { "source": "/geo-dashboard", "destination": "/geo-dashboard.html" },
    { "source": "/competitive-intelligence", "destination": "/competitive-intelligence.html" }
  ]
}
